<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>e59eb612-966e-4a8e-ab22-2b516c05e69f</Id>
  <Version>1.0.0.0</Version>

  <ProviderName>Contoso</ProviderName>

  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="AccountSorter V2"/>

  <Description DefaultValue="Account sorting tool"/>

  <IconUrl DefaultValue="https://sorter-tool.vercel.app/assets/icon-32.png"/>

  <HighResolutionIconUrl DefaultValue="https://sorter-tool.vercel.app/assets/icon-64.png"/>

  <SupportUrl DefaultValue="https://sorter-tool.vercel.app"/>


  <AppDomains>
    <AppDomain>https://sorter-tool.vercel.app</AppDomain>
  </AppDomains>


  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>


  <DefaultSettings>
    <SourceLocation DefaultValue="https://sorter-tool.vercel.app/taskpane.html"/>
  </DefaultSettings>


  <Permissions>ReadWriteDocument</Permissions>


  <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
      xsi:type="VersionOverridesV1_0">


    <Hosts>

      <Host xsi:type="Workbook">

        <DesktopFormFactor>


          <GetStarted>

            <Title resid="GetStarted.Title"/>

            <Description resid="GetStarted.Description"/>

            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>

          </GetStarted>



          <ExtensionPoint xsi:type="PrimaryCommandSurface">


            <OfficeTab id="TabHome">


              <Group id="CommandsGroup">


                <Label resid="CommandsGroup.Label"/>


                <Icon>

                  <bt:Image size="16" resid="Icon.16x16"/>

                  <bt:Image size="32" resid="Icon.32x32"/>

                  <bt:Image size="80" resid="Icon.80x80"/>

                </Icon>



                <Control xsi:type="Button" id="TaskpaneButton">


                  <Label resid="TaskpaneButton.Label"/>


                  <Supertip>

                    <Title resid="TaskpaneButton.Label"/>

                    <Description resid="TaskpaneButton.Tooltip"/>

                  </Supertip>



                  <Icon>

                    <bt:Image size="16" resid="Icon.16x16"/>

                    <bt:Image size="32" resid="Icon.32x32"/>

                    <bt:Image size="80" resid="Icon.80x80"/>

                  </Icon>



                  <Action xsi:type="ShowTaskpane">

                    <TaskpaneId>ButtonId1</TaskpaneId>

                    <SourceLocation resid="Taskpane.Url"/>

                  </Action>


                </Control>


              </Group>


            </OfficeTab>


          </ExtensionPoint>


        </DesktopFormFactor>


      </Host>


    </Hosts>



    <Resources>


      <bt:Images>


        <bt:Image
            id="Icon.16x16"
            DefaultValue="https://sorter-tool.vercel.app/assets/icon-16.png"/>


        <bt:Image
            id="Icon.32x32"
            DefaultValue="https://sorter-tool.vercel.app/assets/icon-32.png"/>


        <bt:Image
            id="Icon.80x80"
            DefaultValue="https://sorter-tool.vercel.app/assets/icon-80.png"/>


      </bt:Images>



      <bt:Urls>


        <bt:Url
            id="GetStarted.LearnMoreUrl"
            DefaultValue="https://learn.microsoft.com/office/dev/add-ins"/>


        <bt:Url
            id="Taskpane.Url"
            DefaultValue="https://sorter-tool.vercel.app/taskpane.html"/>


      </bt:Urls>



      <bt:ShortStrings>


        <bt:String
            id="GetStarted.Title"
            DefaultValue="AccountSorter"/>


        <bt:String
            id="CommandsGroup.Label"
            DefaultValue="Account Tools"/>


        <bt:String
            id="TaskpaneButton.Label"
            DefaultValue="Open AccountSorter"/>


      </bt:ShortStrings>



      <bt:LongStrings>


        <bt:String
            id="GetStarted.Description"
            DefaultValue="Open AccountSorter from the Home tab."/>



        <bt:String
            id="TaskpaneButton.Tooltip"
            DefaultValue="Open Account sorting panel"/>


      </bt:LongStrings>


    </Resources>


  </VersionOverrides>


</OfficeApp>
